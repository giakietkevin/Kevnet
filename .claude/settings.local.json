{
  "permissions": {
    "allow": [
      "Bash(npm install *)",
      "PowerShell(Get-ChildItem -Recurse -Exclude node_modules -File | Where-Object { $_.FullName -notmatch 'node_modules' } | Select-Object FullName)",
      "PowerShell(Get-ChildItem -Path . -Recurse -File | Where-Object { $_.FullName -notmatch 'node_modules' -and $_.FullName -notmatch '\\\\.git' } | Select-Object -ExpandProperty Name)"
    ]
  }
}
